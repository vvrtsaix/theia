# ─────────────────────────────────────────────────────────────────────────────
# Theia — environment variables
#
# Copy to `.env` (or export inline) before running any package.
# Defaults shown below match `infra/docker-compose.yaml` for local dev.
# ─────────────────────────────────────────────────────────────────────────────

# Postgres connection string used by:
#   - `@theia/db` runtime (Drizzle + RLS-bound transactions)
#   - `@theia/auth` (better-auth Drizzle adapter)
#   - `drizzle-kit migrate` (apps/db migrations)
# Format: `postgres://<user>:<pass>@<host>:<port>/<db>`.
DATABASE_URL=postgres://theia:theia@localhost:5432/theia

# Public base URL of the API process. better-auth uses this to construct
# callback / redirect URLs (email verification, password reset, OAuth). Must
# match the externally reachable origin in staging + prod; the local default
# matches the Bun HTTP server in `apps/api`.
BETTER_AUTH_URL=http://localhost:3000

# Comma-separated list of origins allowed to call the auth handler. Required
# whenever the SPA runs on a different origin than the API (e.g. local dev
# where Vite serves the SPA on :5173 and the API on :3000). Production sets
# this to the deployed web app's origin.
BETTER_AUTH_TRUSTED_ORIGINS=http://localhost:5173

# Set to "1" to run the dev bootstrap (`apps/api/src/dev-seed.ts`) which
# plants a known credential (`dev@andsystems.tech` / `devdevdev`) and a
# preconfigured tenant on every boot. NEVER set in staging or production —
# the seed grants `owner` rights on a tenant whose credentials are
# documented in the repo.
THEIA_DEV_SEED=1

# OpenTelemetry OTLP/HTTP traces endpoint. Points at the otel-collector in
# docker-compose, which fans out to Jaeger (UI on :16686). Leave unset to
# disable export; the SDK is built but the exporter quietly drops spans.
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318/v1/traces

# Service identifier on emitted spans. Used by Jaeger / Honeycomb / Tempo to
# group traces. Override per process (e.g. `theia-worker`, `theia-api`) when
# multiple Theia services run in the same observability backend.
OTEL_SERVICE_NAME=theia-api

# Semantic version tag attached to every span. Use the build SHA or release
# tag in CI so traces can be correlated with a specific deployment.
OTEL_SERVICE_VERSION=0.0.0
