# build
dist/
build/
.tsbuildinfo
*.tsbuildinfo

# env — Vite-style cascade
# `.env` and `.env.{mode}` are committable defaults (no secrets).
# `*.local` variants are always gitignored (local overrides + secrets).
.env.local
.env.*.local

# editor
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
*.swp
.DS_Store

# logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*

# test
coverage/
.nyc_output/

# OS / misc
.cache/
tmp/
